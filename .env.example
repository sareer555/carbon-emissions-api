# Copy this file to .env and adjust for your environment.

ENVIRONMENT=development

# SQLite (default, zero-config local dev):
DATABASE_URL=sqlite:///./carbon_emissions.db

# Postgres (Supabase/Neon free tier) for production, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: Upstash/Redis URL for a cross-instance rate limiter.
# Leave unset to use the built-in in-memory limiter (fine for one instance).
# REDIS_URL=rediss://default:password@host:6379

BURST_LIMIT_PER_MINUTE=60
